---
import "@/styles/global.css";
import "@/styles/importer.css";

interface Props {
  title?: string;
}

const {
  title = "AniKawa Importer",
} = Astro.props;
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#101116"
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>